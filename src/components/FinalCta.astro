---
interface Props {
  eyebrow?: string;
  title: string;
  body: string;
  primary?: { href: string; label: string };
  secondary?: { href: string; label: string };
}

const {
  eyebrow = "Gefällt Ihnen unsere Arbeit?",
  title,
  body,
  primary = { href: "/kontakt", label: "Projekt anfragen" },
  secondary,
} = Astro.props;
---

<section class="final-cta">
  <div class="inner">
    <p class="eyebrow" style="justify-content:center;">{eyebrow}</p>
    <h2 set:html={title} />
    <p>{body}</p>
    <div style="display:inline-flex;gap:12px;flex-wrap:wrap;justify-content:center;">
      <a class="btn" href={primary.href}>
        {primary.label} <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
      </a>
      {
        secondary && (
          <a class="btn btn-outline" href={secondary.href}>
            {secondary.label}
          </a>
        )
      }
    </div>
  </div>
</section>
