---
import { getEntry, render } from "astro:content";
import LegalLayout from "../layouts/LegalLayout.astro";

const entry = await getEntry("legal", "impressum");
if (!entry) throw new Error("Impressum entry not found");
const { Content } = await render(entry);
---

<LegalLayout
  title={entry.data.title}
  subtitle={entry.data.subtitle}
  stand={entry.data.stand}
  description="Impressum von EHB Filmworks — Angaben gemäss Schweizer Obligationenrecht."
  active="impressum"
>
  <Content />
</LegalLayout>
